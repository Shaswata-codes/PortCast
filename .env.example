# PortCast environment configuration (copy to .env as needed)

# Express API
PORT=5000
NODE_ENV=development

# ML microservice bridge
ML_SERVICE_URL=http://127.0.0.1:8000

# Auth (only used by /api/users routes; Mongo is disabled in analytics mode)
JWT_SECRET=change-me
# MONGO_URI=mongodb://127.0.0.1:27017/portcast

# Client (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
